# ---------------------------------------------------------------
# Public site: no API key needed (maps, addresses and routing use
# IGN Géoplateforme, a free public service).
# ---------------------------------------------------------------

# Optional: extra origins allowed to call the API (same-origin is always allowed)
ALLOWED_ORIGINS=https://www.aa-vtc.fr,https://aa-vtc.fr

# ---------------------------------------------------------------
# Administration (/admin) — required for the dashboard
# ---------------------------------------------------------------

# Postgres connection string (Vercel → Storage → Neon → .env.local)
DATABASE_URL=

# Admin account. Generate the hash and the secret with:
#   node scripts/hash-password.mjs "votre-mot-de-passe"
ADMIN_EMAIL=contact@aa-vtc.fr
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Optional: legal line printed at the bottom of every devis PDF
# COMPANY_LEGAL=AA-VTC — SIRET 000 000 000 00000 — Capacité VTC n° 000000

# ---------------------------------------------------------------
# Devis PDF — company identity (printed on every devis)
# Leave empty and the block is simply omitted; nothing is invented.
# ---------------------------------------------------------------
COMPANY_NAME=AA-VTC
COMPANY_ADDRESS=
COMPANY_SIRET=
COMPANY_VTC=
COMPANY_TVA=
COMPANY_SIGNER=
# Optional overrides (defaults shown)
# COMPANY_PHONE=+33 6 52 80 74 88
# COMPANY_EMAIL=contact@aa-vtc.fr
# COMPANY_SITE=www.aa-vtc.fr
