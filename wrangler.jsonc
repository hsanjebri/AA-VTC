{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aa-vtc",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true, // keeps aa-vtc.aa-vtc.workers.dev alive as a fallback/test URL

  // Cloudflare manages the DNS for these hostnames and issues the certificates.
  // Email records (MX, SPF/DKIM TXT, SRV, autoconfig CNAMEs) are untouched.
  "routes": [
    { "pattern": "aa-vtc.fr", "custom_domain": true },
    { "pattern": "www.aa-vtc.fr", "custom_domain": true },
    { "pattern": "aa-vtc.com", "custom_domain": true },
    { "pattern": "www.aa-vtc.com", "custom_domain": true }
  ],

  // Only public/ is published. Server code, .env.local and private/ stay out of the upload.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Non-secret configuration. Secrets (DATABASE_URL, ADMIN_PASSWORD_HASH, SESSION_SECRET)
  // are set with: npx wrangler secret put NAME
  "vars": {
    "ADMIN_EMAIL": "contact@aa-vtc.fr",
    "ALLOWED_ORIGINS": "https://aa-vtc.fr,https://www.aa-vtc.fr",
    "COMPANY_NAME": "AA-VTC",
    "COMPANY_PHONE": "+33 6 52 80 74 88",
    "COMPANY_EMAIL": "contact@aa-vtc.fr",
    "COMPANY_SITE": "aa-vtc.fr"
  }
}
