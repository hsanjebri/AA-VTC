{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aa-vtc",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true, // keeps aa-vtc.workers.dev alive as a fallback/test URL

  // Cloudflare manages the DNS for these hostnames and issues the certificates.
  // Email records (MX, SPF/DKIM TXT, SRV, autoconfig CNAMEs) are untouched.
  "routes": [
    { "pattern": "ej-vtc.fr", "custom_domain": true },
    { "pattern": "www.ej-vtc.fr", "custom_domain": true },
    // ej-vtc.com : à ajouter une fois la zone créée sur Cloudflare (DNSSEC à
    // désactiver d'abord chez OVH, une opération « DS records » y est active).
    { "pattern": "aa-vtc.fr", "custom_domain": true },
    { "pattern": "www.aa-vtc.fr", "custom_domain": true },
    { "pattern": "aa-vtc.com", "custom_domain": true },
    { "pattern": "www.aa-vtc.com", "custom_domain": true }
  ],

  // Only public/ is published; the server code stays out of the upload.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // true (not just /api/*): the Worker must see every request to apply the canonical
    // host + HTTPS redirects, which asset-only requests would otherwise bypass.
    "run_worker_first": true
  },

  // Edge rate limiting (counts across isolates, unlike an in-memory map).
  "unsafe": {
    "bindings": [
      {
        "name": "FARE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }
    ]
  },

  // No secrets: the site stores nothing and calls only the free public IGN services.
  "vars": {
    "ALLOWED_ORIGINS": "https://ej-vtc.fr,https://www.ej-vtc.fr,https://aa-vtc.fr,https://www.aa-vtc.fr"
  }
}
